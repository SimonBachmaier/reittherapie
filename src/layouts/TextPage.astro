---
import { getEntry, render } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import SiteSection from '../components/SiteSection.astro';
import Text from '../components/Text.astro';

interface Props {
  id: string;
}

const page = await getEntry('seiten', Astro.props.id);
if (!page) throw new Error(`src/content/seiten/${Astro.props.id}.md is missing`);
const { Content } = await render(page);
---

<BaseLayout siteTitle={page.data.siteTitle} headerText={page.data.siteTitle}>
  <SiteSection>
    <Text>
      <div><Content /></div>
    </Text>
  </SiteSection>
</BaseLayout>
