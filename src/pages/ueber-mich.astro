---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteSection from '../components/SiteSection.astro';
import Text from '../components/Text.astro';
import TextImage from '../components/TextImage.astro';

const page = await getEntry('seiten', 'ueber-mich');
if (!page) throw new Error('src/content/seiten/ueber-mich.md is missing');
const { Content } = await render(page);
const { siteTitle, headerImage, image, headline, subheadline, textNextToImage } = page.data;
---

<BaseLayout siteTitle={siteTitle} headerText={siteTitle} headerImage={headerImage}>
  <SiteSection>
    <TextImage class="pt-5" image={image} headline={headline} subheadline={subheadline} markdown={textNextToImage} />
    <Text>
      <div><Content /></div>
    </Text>
  </SiteSection>
</BaseLayout>
